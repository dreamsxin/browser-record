{
  "port": 5000,
  "host": "127.0.0.1",
  "profilesDir": "./profiles",
  "browser": {
    "executablePath": "",
    "headless": false,
    "args": ["--no-first-run", "--no-default-browser-check"],
    "startingUrl": "about:blank"
  },
  "recordingMode": "live-trace",
  "liveTrace": {
    "checkpointIntervalMs": 30000,
    "snapshots": true,
    "screenshots": true,
    "sources": false
  },
  "recording": {
    "segmentDurationMs": 1800000,
    "deleteAfterUpload": true,
    "retry": {
      "maxAttempts": 5,
      "baseDelayMs": 2000,
      "maxDelayMs": 60000
    }
  },
  "storageServerUrl": "http://localhost:4000",
  "uploadToken": "dev-upload-token"
}
