{
  "port": 5000,
  "host": "127.0.0.1",
  "profilesDir": "./profiles",
  "browser": {
    "executablePath": "",
    "headless": false,
    "args": ["--no-first-run", "--no-default-browser-check"],
    "startingUrl": "about:blank"
  },
  "recordingMode": "operations",
  "operations": {
    "chunkDurationMs": 30000,
    "maxEvents": 100,
    "maxScreenshotsPerSecond": 4,
    "screenshotQuality": 65,
    "captureNetworkSummary": true,
    "captureConsole": true
  },
  "recording": {
    "segmentDurationMs": 1800000,
    "deleteAfterUpload": true,
    "retry": {
      "maxAttempts": 5,
      "baseDelayMs": 2000,
      "maxDelayMs": 60000
    }
  },
  "storageServerUrl": "http://localhost:4000",
  "uploadToken": "dev-upload-token"
}
