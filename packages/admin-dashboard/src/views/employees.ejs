<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>员工列表 — 操作监控后台</title>
  <link rel="stylesheet" href="/app.css" />
</head>
<body>
  <nav class="navbar">
    <div class="brand"><a href="/employees">操作监控后台</a></div>
    <div class="actions">
      <span class="muted"><%= user.username %></span>
      <form method="POST" action="/logout" style="display:inline;margin-left:12px;">
        <button type="submit" class="btn btn-ghost">退出</button>
      </form>
    </div>
  </nav>
  <div class="container">
    <div class="card">
      <div class="card-header">员工列表</div>
      <% if (employees.length === 0) { %>
        <div class="empty">暂无录制数据</div>
      <% } else { %>
      <table>
        <thead>
          <tr>
            <th>员工 ID</th>
            <th>状态</th>
            <th>会话数</th>
            <th>分段数</th>
            <th>总大小</th>
            <th>最近活动</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% employees.forEach((e) => { %>
          <tr>
            <td><%= e.employeeId %></td>
            <td><%= e.status === 'active' ? '活动中' : e.status %></td>
            <td><%= e.sessionCount %></td>
            <td><%= e.segmentCount %></td>
            <td><%= e.totalBytesFmt %></td>
            <td><%= e.lastEndFmt %></td>
            <td><a class="link" href="/employees/<%= encodeURIComponent(e.employeeId) %>/sessions">查看会话 →</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</body>
</html>
