<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>视频回放 — Browser Record</title><link rel="stylesheet" href="/app.css"></head><body>
<nav class="navbar"><div class="brand"><a href="/employees">操作监控后台</a></div><span class="muted"><%= user.username %></span></nav>
<div class="container"><div class="breadcrumb"><a href="/employees">员工</a> / <a href="/employees/<%= encodeURIComponent(employeeId) %>/sessions"><%= employeeId %></a> / <%= sessionId %> / 视频回放</div>
<div class="card"><div class="card-header">视频回放</div><div style="padding:20px">
<p class="muted">状态：<%= manifest.status %>　开始：<%= new Date(manifest.startedAt).toLocaleString('zh-CN',{hour12:false}) %>　结束：<%= new Date(manifest.endedAt).toLocaleString('zh-CN',{hour12:false}) %></p>
<% if (!manifest.videos.length) { %><div class="empty">没有可播放的视频</div><% } %>
<% manifest.videos.forEach((v) => { %><div style="margin-bottom:24px"><h3><%= v.pageId %></h3><video controls preload="metadata" style="width:100%;max-height:70vh;background:#111" src="/video/<%= encodeURIComponent(employeeId) %>/<%= encodeURIComponent(sessionId) %>/<%= encodeURIComponent(v.pageId) %>/stream"></video></div><% }) %>
</div></div></div></body></html>
